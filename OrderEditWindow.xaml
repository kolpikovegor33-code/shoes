<Window x:Class="shoes.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Icon="/Image/Icon.png"
        Height="780"
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Times New Roman"
        FontSize="14"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#7FFF00">
            <TextBlock x:Name="textHeader"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="25,15,25,0">

            <TextBlock Text="Клиент" Margin="0,0,0,2"/>
            <ComboBox x:Name="comboUser"
                      Height="28"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="UserId"
                      Margin="0,0,0,8"/>

            <TextBlock Text="Пункт выдачи" Margin="0,0,0,2"/>
            <ComboBox x:Name="comboPickup"
                      Height="28"
                      DisplayMemberPath="Address"
                      SelectedValuePath="PickupPointId"
                      Margin="0,0,0,8"/>

            <TextBlock Text="Дата заказа" Margin="0,0,0,2"/>
            <DatePicker x:Name="datePickerOrder"
                        Height="28"
                        Margin="0,0,0,8"/>

            <TextBlock Text="Дата доставки" Margin="0,0,0,2"/>
            <DatePicker x:Name="datePickerDelivery"
                        Height="28"
                        Margin="0,0,0,8"/>

            <TextBlock Text="Код получения" Margin="0,0,0,2"/>
            <TextBox x:Name="textCode"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Статус заказа" Margin="0,0,0,2"/>
            <ComboBox x:Name="comboStatus"
                      Height="28"
                      IsEditable="True"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Состав заказа" FontWeight="Bold" Margin="0,0,0,4"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="comboProduct"
                          Grid.Column="0"
                          Height="28"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Article"
                          Margin="0,0,6,0"/>

                <TextBox x:Name="textCount"
                         Grid.Column="1"
                         Height="28"
                         Text="1"
                         VerticalContentAlignment="Center"
                         Margin="0,0,6,0"/>

                <Button Grid.Column="2"
                        Height="28"
                        Content="Добавить"
                        Background="#00FA9A"
                        Click="ButtonAddItem_Click"/>
            </Grid>

            <ListBox x:Name="listItems"
                     Height="120"
                     DisplayMemberPath="Display"
                     Margin="0,0,0,6"/>

            <Button Content="Убрать выбранный товар"
                    Width="190"
                    Height="28"
                    HorizontalAlignment="Left"
                    Background="White"
                    Click="ButtonRemoveItem_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,25,0">

            <Button Content="Назад"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Background="White"
                    Click="ButtonBack_Click"/>

            <Button Content="Сохранить"
                    Width="120"
                    Height="34"
                    FontWeight="Bold"
                    Background="#00FA9A"
                    Click="ButtonSave_Click"/>
        </StackPanel>
    </Grid>
</Window>