<Window x:Class="shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров"
        Icon="/Image/Icon.png"
        Height="700"
        Width="950"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        FontSize="14"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#7FFF00">

            <Image Source="/Image/Icon.png"
                   Width="70"
                   Height="70"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="10"
                   Stretch="Uniform"/>

            <TextBlock Text="Каталог товаров"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0">

                <TextBlock x:Name="textUserName"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>

                <TextBlock x:Name="textUserRole"
                           HorizontalAlignment="Right"/>

                <Button x:Name="buttonLogout"
                        Content="Выйти"
                        Width="90"
                        Height="28"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right"
                        Background="#00FA9A"
                        Click="ButtonLogout_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="panelActions"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="10,10,10,0"
                    Visibility="Collapsed">

            <Button x:Name="buttonOrders"
                    Content="Заказы"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="ButtonOrders_Click"/>

            <Button x:Name="buttonAddProduct"
                    Content="Добавить товар"
                    Width="140"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="#00FA9A"
                    Visibility="Collapsed"
                    Click="ButtonAddProduct_Click"/>

            <Button x:Name="buttonDeleteProduct"
                    Content="Удалить товар"
                    Width="140"
                    Height="30"
                    Background="White"
                    Visibility="Collapsed"
                    Click="ButtonDeleteProduct_Click"/>
        </StackPanel>

        <Grid x:Name="panelFilters"
              Grid.Row="2"
              Margin="10,10,10,0"
              Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Поиск" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="textSearch"
                         Height="28"
                         VerticalContentAlignment="Center"
                         TextChanged="TextSearch_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Сортировка по количеству на складе" FontWeight="Bold" Margin="0,0,0,3"/>
                <ComboBox x:Name="comboSort"
                          Width="260"
                          Height="28"
                          SelectedIndex="0"
                          SelectionChanged="ComboSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="По возрастанию"/>
                    <ComboBoxItem Content="По убыванию"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Поставщик" FontWeight="Bold" Margin="0,0,0,3"/>
                <ComboBox x:Name="comboSupplier"
                          Width="220"
                          Height="28"
                          SelectionChanged="ComboSupplier_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">

            <ListBox x:Name="listProducts"
                     Margin="10"
                     BorderThickness="0"
                     Background="White"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ListProducts_MouseDoubleClick">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border BorderBrush="Black"
                                BorderThickness="1"
                                Padding="5"
                                Margin="0,5,0,5"
                                Background="{Binding Background}">

                            <Grid MinHeight="160">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        Margin="0,0,5,0">

                                    <Image Source="{Binding Photo}"
                                           Margin="5"
                                           Stretch="Uniform"/>
                                </Border>

                                <Border Grid.Column="1"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        Margin="0,0,5,0"
                                        Padding="8">

                                    <StackPanel>

                                        <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                                            <Run Text="{Binding Category, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Title}"/>
                                        </TextBlock>

                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Описание товара: "/>
                                            <Run Text="{Binding Description, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock>
                                            <Run Text="Производитель: "/>
                                            <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock>
                                            <Run Text="Поставщик: "/>
                                            <Run Text="{Binding Supplier, Mode=OneWay}"/>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Цена: "/>

                                            <TextBlock Text="{Binding OldPrice}"
                                                       Foreground="Red"
                                                       Margin="0,0,8,0"
                                                       TextDecorations="Strikethrough"
                                                       Visibility="{Binding OldPriceVisibility}"/>

                                            <TextBlock Text="{Binding FinalPrice}"
                                                       Foreground="Black"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <TextBlock>
                                            <Run Text="Единица измерения: "/>
                                            <Run Text="{Binding Unit, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock>
                                            <Run Text="Количество на складе: "/>
                                            <Run Text="{Binding Stock, Mode=OneWay}"/>
                                        </TextBlock>

                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        BorderBrush="Black"
                                        BorderThickness="1">

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="Действующая скидка"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding DiscountText}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="textNoResults"
                       Text="Товары не найдены"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

    </Grid>
</Window>